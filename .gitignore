# ============================================
# .gitignore — Sistemas Programables ISC TecNM León
# Cubre: MicroPython, Python, PlatformIO, Firebase, Node, macOS, Windows
# ============================================

# --- MicroPython / ESP32 ---
*.mpy
__pycache__/
*.pyc

# --- PlatformIO ---
.pio/
.clangd/
*.hex
*.elf
*.bin
*.map

# --- Python ---
*.egg-info/
dist/
build/
venv/
.env
.env.local
*.log

# --- Firebase ---
.firebase/
firebase-debug.log
firestore-debug.log
.firebaserc
# OJO: sí subir firebase.json y reglas.json

# --- Node / Dashboard web ---
node_modules/
.npm/
*.lock

# --- IDEs y editores ---
.vscode/
.idea/
*.suo
*.user

# --- macOS ---
.DS_Store
.AppleDouble
__MACOSX/

# --- Windows ---
Thumbs.db
desktop.ini

# --- Archivos pesados (van a YouTube/Drive) ---
*.mp4
*.avi
*.mov
*.mkv
# Excepción: GIFs cortos de demo sí se permiten
!demo.gif
!demo-short.gif

# --- Credenciales (NUNCA subir) ---
serviceAccountKey.json
*credentials*.json
*secret*.json
*.pem
*.key
